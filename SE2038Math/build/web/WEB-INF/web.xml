<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <servlet>
        <servlet-name>MathServlet</servlet-name>
        <servlet-class>controllers.MathServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GCDServlet</servlet-name>
        <servlet-class>controllers.GCDServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>TinhTongServlet</servlet-name>
        <servlet-class>controllers.TinhTongServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>TienDienServlet</servlet-name>
        <servlet-class>controllers.TienDienServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>MoneyExchangeServlet</servlet-name>
        <servlet-class>controllers.MoneyExchangeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MathServlet</servlet-name>
        <url-pattern>/mymath</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GCDServlet</servlet-name>
        <url-pattern>/commondiv</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TinhTongServlet</servlet-name>
        <url-pattern>/tinhtong</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TienDienServlet</servlet-name>
        <url-pattern>/tiendien</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>MoneyExchangeServlet</servlet-name>
        <url-pattern>/moneyexchange</url-pattern>
    </servlet-mapping>
</web-app>
